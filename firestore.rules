rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Players collection
    match /players/{userId} {
      // Anyone can read player profiles
      allow read: if true;

      // Only the user can create their initial character
      // In production, even this should be a Cloud Function to prevent spoofing starting stats
      allow create: if request.auth != null && request.auth.uid == userId;

      // Critical game state is locked. Only non-critical fields can be updated by client.
      // gold, xp, stats, energy, level, bounty, etc. are SERVER-ONLY.
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['gold', 'xp', 'stats', 'energy', 'level', 'bounty', 'combatState', 'energyUpdatedAt']);

      allow delete: if false; // Characters cannot be deleted by clients
    }

    // Chat collection
    match /chat/{messageId} {
      allow read: if request.auth != null;

      // Server-authoritative chat would be better, but we can enforce sender identity here
      allow create: if request.auth != null
        && request.resource.data.senderName == request.auth.token.name;

      allow update, delete: if false;
    }

    // Missions collection (Game Data)
    match /missions/{missionId} {
      allow read: if true;
      allow write: if false; // Game data is read-only for clients
    }

    // Crews collection
    match /crews/{crewId} {
      allow read: if true;
      allow write: if false; // Only Cloud Functions can update crew data
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
