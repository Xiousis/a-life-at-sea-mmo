rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Players collection
    match /players/{userId} {
      // Anyone can read player profiles
      allow read: if true;

      // Characters must be created via Cloud Function to ensure valid starting stats and unique names
      allow create: if false;

      // Critical game state is locked. Client can only update non-essential fields (like title if we want, or avatar).
      // Most game fields are now SERVER-ONLY.
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'gold', 'xp', 'stats', 'energy', 'level', 'bounty', 'hp', 'maxHp',
              'maxEnergy', 'currentLocation', 'travelState', 'combatState',
              'energyUpdatedAt', 'inventory', 'equipment', 'crewId', 'pvpWins', 'pvpLosses'
            ]);

      allow delete: if false; // Characters cannot be deleted by clients
    }

    // Chat collection
    match /chat/{messageId} {
      allow read: if request.auth != null;

      // Server-authoritative chat would be better, but we can enforce sender identity here
      allow create: if request.auth != null
        && request.resource.data.senderName == request.auth.token.name;

      allow update, delete: if false;
    }

    // Missions collection (Game Data)
    match /missions/{missionId} {
      allow read: if true;
      allow write: if false; // Game data is read-only for clients
    }

    // Crews collection
    match /crews/{crewId} {
      allow read: if true;
      allow write: if false; // Only Cloud Functions can update crew data
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
