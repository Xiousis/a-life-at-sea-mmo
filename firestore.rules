rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Players collection
    match /players/{userId} {
      // Anyone logged in can read public player profiles
      allow read: if request.auth != null;

      // Characters must be created via Cloud Function
      allow create: if false;

      // Game logic fields are SERVER-ONLY.
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title', 'avatarUrl', 'settings', 'isOnline', 'lastOnline']);

      allow delete: if false;

      // Private data sub-collection
      match /private/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Chat collection
    match /chat/{messageId} {
      // Enforce crew membership for reading crew channels
      allow read: if request.auth != null && (
        resource.data.channelId == 'global' ||
        get(/databases/$(database)/documents/players/$(request.auth.uid)).data.crewId == resource.data.channelId
      );

      // Clients can send messages if they belong to the channel
      allow create: if request.auth != null && (
        request.resource.data.channelId == 'global' ||
        get(/databases/$(database)/documents/players/$(request.auth.uid)).data.crewId == request.resource.data.channelId
      ) && request.resource.data.message.size() <= 200; // Basic length limit

      allow update, delete: if false;
    }

    // Static Game Data (World, Items, Loot, Skills)
    match /gameData/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Crews collection
    match /crews/{crewId} {
      allow read: if true;
      allow write: if false; // Only Cloud Functions can update crew data
    }

    // Social collections
    match /friendRequests/{requestId} {
      allow read: if request.auth != null && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow write: if false;
    }

    match /crewInvites/{inviteId} {
      allow read: if request.auth != null && (resource.data.senderId == request.auth.uid || resource.data.targetId == request.auth.uid);
      allow write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
